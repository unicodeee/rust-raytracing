# The same positions and triangles as pyramid_hard.obj, but normals are shared
# by position so interpolation visibly smooths the connected faces.
v -1 0  1
v  1 0  1
v  1 0 -1
v -1 0 -1
v  0 2  0

vn -0.577350 0.577350  0.577350
vn  0.577350 0.577350  0.577350
vn  0.577350 0.577350 -0.577350
vn -0.577350 0.577350 -0.577350
vn  0.000000 1.000000  0.000000

f 1//1 4//4 3//3
f 1//1 3//3 2//2
f 1//1 2//2 5//5
f 2//2 3//3 5//5
f 3//3 4//4 5//5
f 4//4 1//1 5//5
